<h1>Produtos</h1>
{{#if user}}
{{#if isAdminOrPremium}}
<a href="/products/add">Adicionar Produto</a>
{{/if}}
{{/if}}
<ul>
  {{#each products}}
  <li>
    {{this.name}} - Preço: {{this.price}}
    {{#if ../user}}
    {{#if ../isAdminOrPremium}}
    <a href="/products/edit/{{this._id}}">Editar</a>
    <form action="/products/{{this._id}}?_method=DELETE" method="post" style="display: inline;">
      <button type="submit">Excluir</button>
    </form>
    {{/if}}
    {{/if}}
  </li>
  {{/each}}
</ul>